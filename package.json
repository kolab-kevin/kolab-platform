{
  "name": "kolab-platform",
  "private": true,
  "scripts": {
    "prepare": "husky",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint && pnpm lint:md",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\"",
    "lint:md:docs": "markdownlint-cli2 \"docs/**/*.md\"",
    "ci:prepare-backend": "pnpm db:generate && pnpm --filter @kolab/types build && pnpm --filter @kolab/config build && pnpm --filter @kolab/auth build && pnpm --filter @kolab/database build && pnpm --filter @kolab/storage build && pnpm --filter @kolab/observability build",
    "ci:backend": "pnpm --filter @kolab/database exec prisma validate --schema prisma/schema.prisma && pnpm ci:prepare-backend && pnpm --filter @kolab/auth test && pnpm --filter @kolab/storage test && pnpm --filter @kolab/api typecheck && pnpm --filter @kolab/api test && pnpm --filter @kolab/api lint && pnpm lint:md:docs",
    "lint:fix": "turbo lint && markdownlint-cli2 --fix \"**/*.md\" \"!**/node_modules/**\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yml,yaml,css}\"",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm audit:ci && pnpm check:cycles && pnpm check:licenses && pnpm build",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "audit": "pnpm audit --audit-level=high",
    "audit:ci": "pnpm audit --audit-level=high --prod",
    "db:generate": "pnpm --filter @kolab/database db:generate",
    "db:migrate": "pnpm --filter @kolab/database db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @kolab/database db:migrate:deploy",
    "db:studio": "pnpm --filter @kolab/database db:studio",
    "db:seed": "pnpm --filter @kolab/database db:seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "clean": "turbo run clean && rimraf node_modules/.cache",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.11",
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@kolab/eslint-config": "workspace:*",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.3.0",
    "madge": "^8.0.0",
    "markdownlint-cli2": "^0.17.2",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "lodash": "4.18.1",
      "multer": "2.2.0"
    }
  },
  "lint-staged": {
    "apps/**/*.{ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "packages/**/src/**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "scripts/**/*.{js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{js,jsx,mjs,cjs,ts,tsx,json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.md": [
      "markdownlint-cli2 --fix"
    ]
  }
}
