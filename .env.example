# ─── Infrastructure ───────────────────────────────────────────────
POSTGRES_USER=kolab
POSTGRES_PASSWORD=kolab
POSTGRES_DB=kolab
DATABASE_URL=postgresql://kolab:kolab@postgres:5432/kolab
REDIS_URL=redis://redis:6379

# ─── JWT ──────────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-secure-random-string-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Service URLs (Docker network) ────────────────────────────────
API_URL=http://api:4000
PUBLIC_API_URL=http://public-api:4001
MOBILE_API_URL=http://mobile-api:4002
AI_SERVICES_URL=http://ai-services:4003

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_PUBLIC_API_URL=http://localhost:4001

WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
CREATOR_PORTAL_URL=http://localhost:3002
MODERATOR_URL=http://localhost:3003

# ─── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003
