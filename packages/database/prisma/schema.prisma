generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Phase 1 legacy enums — retained during Release 0.2 migration (Phase A)
enum Role {
  USER
  CREATOR
  MODERATOR
  ADMIN
  SUPER_ADMIN
}

enum Platform {
  KOLAB_AGENCY
  TIKTOK_CREATOR
  TIKTOK_SHOP
  AI_SERVICES
  LIVE_STREAMING
  SYMLCAST
}

enum OrganizationType {
  STANDARD
  AGENCY
  CREATOR
  MERCHANT
  ENTERPRISE
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum OrganizationRole {
  ORG_OWNER
  ORG_ADMIN
  AGENCY_MANAGER
  RECRUITER
  CREATOR
  MODERATOR
  FINANCE
  SUPPORT
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REMOVED
}

enum LeadStatus {
  NEW
  CONTACTED
  INTERESTED
  APPLICATION
  CONTRACT_SENT
  SIGNED
  ACTIVE_CREATOR
  INACTIVE
  REJECTED
}

enum LeadSource {
  MANUAL
  REFERRAL
  SOCIAL
  EVENT
  IMPORT
  OTHER
}

enum PlatformType {
  TIKTOK
  INSTAGRAM
  YOUTUBE
  FACEBOOK
  TWITCH
  OTHER
}

enum ContactType {
  CALL
  WHATSAPP
  TIKTOK
  FACEBOOK
  EMAIL
  MEETING
  OTHER
}

enum CommissionPlan {
  STANDARD
  PREMIUM
  CUSTOM
}

enum LeadPlatformAccountStatus {
  ACTIVE
  UNVERIFIED
  SUSPENDED
  REMOVED
}

enum RecruiterStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CreatorStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum CreatorDocumentType {
  GOVERNMENT_ID
  PASSPORT
  TAX_FORM
  BANK_INFO
  PROFILE_PHOTO
  CONTRACT_ATTACHMENT
  OTHER
}

enum CreatorDocumentStatus {
  REQUESTED
  UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  ARCHIVED
}

enum CreatorContractType {
  CREATOR_AGREEMENT
  AGENCY_AGREEMENT
  CAMPAIGN_CONTRACT
  NDA
  OTHER
}

enum CreatorContractStatus {
  DRAFT
  SENT
  VIEWED
  SIGNED
  EXPIRED
  CANCELLED
  TERMINATED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique
  passwordHash   String     @map("password_hash")
  role           Role       @default(USER)
  platforms      Platform[] @default([])
  isSystemAdmin  Boolean    @default(false) @map("is_system_admin")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  profile                 UserProfile?
  refreshTokens           RefreshToken[]
  sessions                Session[]
  memberships             OrganizationMembership[] @relation("MemberUser")
  invitedMemberships      OrganizationMembership[] @relation("MembershipInviter")
  sentInvitations         Invitation[]             @relation("InvitationInviter")
  auditLogs               AuditLog[]               @relation("AuditActor")
  assignedCreatorLeads    CreatorLead[]            @relation("LeadAssignedRecruiter")
  convertedCreatorLeads   CreatorLead[]            @relation("LeadConvertedCreator")
  leadAssignments         LeadAssignment[]         @relation("LeadAssignmentRecruiter")
  leadAssignmentsCreated  LeadAssignment[]         @relation("LeadAssignmentAssigner")
  leadNotes               LeadNote[]               @relation("LeadNoteAuthor")
  leadStatusChanges       LeadStatusHistory[]      @relation("LeadStatusChanger")
  recruiterProfiles       RecruiterProfile[]       @relation("RecruiterProfileUser")
  managedRecruiterProfiles RecruiterProfile[]      @relation("RecruiterProfileManager")
  creatorProfiles         CreatorProfile[]         @relation("CreatorProfileUser")
  assignedCreatorProfiles CreatorProfile[]         @relation("CreatorProfileRecruiter")
  reviewedCreatorDocuments CreatorDocument[]       @relation("CreatorDocumentReviewer")
  uploadedCreatorDocumentVersions CreatorDocumentVersion[] @relation("CreatorDocumentVersionUploader")
  signedCreatorContracts  CreatorContract[]        @relation("CreatorContractSigner")
  signedCreatorContractVersions CreatorContractVersion[] @relation("CreatorContractVersionSigner")
  createdCampaigns        Campaign[]               @relation("CampaignCreator")

  @@map("users")
}

model UserProfile {
  userId      String  @id @map("user_id")
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String? @map("display_name")
  avatarUrl   String? @map("avatar_url")
  bio         String?
  language    String  @default("en")
  timezone    String  @default("UTC")
  country     String?

  @@map("user_profiles")
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  type      OrganizationType   @default(STANDARD)
  status    OrganizationStatus @default(ACTIVE)
  settings  Json               @default("{}")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")

  memberships OrganizationMembership[]
  invitations Invitation[]
  sessions    Session[]
  auditLogs   AuditLog[]
  agencyProfile  AgencyProfile?
  agencySettings AgencySettings?
  creatorLeads   CreatorLead[]
  leadPlatformAccounts LeadPlatformAccount[]
  leadAssignments      LeadAssignment[]
  leadNotes            LeadNote[]
  leadStatusHistory    LeadStatusHistory[]
  recruiterProfiles    RecruiterProfile[]
  creatorProfiles      CreatorProfile[]
  creatorPlatformAccounts CreatorPlatformAccount[]
  creatorDocuments     CreatorDocument[]
  creatorDocumentVersions CreatorDocumentVersion[]
  creatorContracts     CreatorContract[]
  creatorContractVersions CreatorContractVersion[]
  campaigns            Campaign[]
  campaignDeliverables CampaignDeliverable[]

  @@index([status])
  @@map("organizations")
}

model AgencyProfile {
  organizationId     String       @id @map("organization_id")
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  description        String?
  logoUrl            String?      @map("logo_url")
  website            String?
  primaryContact     String?      @map("primary_contact")
  phone              String?
  country            String?
  timezone           String       @default("UTC")
  supportedLanguages String[]     @default(["en"]) @map("supported_languages")
  socialLinks        Json         @default("{}") @map("social_links")
  businessSettings   Json         @default("{}") @map("business_settings")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  @@map("agency_profiles")
}

model AgencySettings {
  organizationId String       @id @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  settings       Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@map("agency_settings")
}

model OrganizationMembership {
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String           @map("user_id")
  user           User             @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole
  status         MembershipStatus @default(ACTIVE)
  invitedBy      String?          @map("invited_by")
  inviter        User?            @relation("MembershipInviter", fields: [invitedBy], references: [id], onDelete: SetNull)
  joinedAt       DateTime         @default(now()) @map("joined_at")

  @@id([organizationId, userId])
  @@index([userId])
  @@index([organizationId, status])
  @@map("organization_memberships")
}

model Session {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId   String?   @map("organization_id")
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  refreshTokenHash String?   @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")

  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([organizationId])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?  @map("session_id")
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([sessionId])
  @@map("refresh_tokens")
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           OrganizationRole
  tokenHash      String           @unique @map("token_hash")
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  invitedBy      String           @map("invited_by")
  inviter        User             @relation("InvitationInviter", fields: [invitedBy], references: [id], onDelete: Restrict)

  @@index([organizationId, email])
  @@index([expiresAt])
  @@map("invitations")
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actorUserId    String?       @map("actor_user_id")
  actor          User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetType     String        @map("target_type")
  targetId       String        @map("target_id")
  action         String
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@index([targetType, targetId])
  @@map("audit_logs")
}

model CreatorLead {
  id                   String         @id @default(cuid())
  organizationId       String         @map("organization_id")
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                 String
  nickname             String?
  email                String?
  phone                String?
  country              String?
  languages            String[]       @default([])
  source               LeadSource     @default(MANUAL)
  status               LeadStatus     @default(NEW)
  score                Int            @default(0)
  assignedRecruiterId  String?        @map("assigned_recruiter_id")
  assignedRecruiter    User?          @relation("LeadAssignedRecruiter", fields: [assignedRecruiterId], references: [id], onDelete: SetNull)
  assignedAt           DateTime?      @map("assigned_at")
  nextFollowUpAt       DateTime?      @map("next_follow_up_at")
  commissionPlan       CommissionPlan @default(STANDARD) @map("commission_plan")
  convertedUserId      String?        @map("converted_user_id")
  convertedUser        User?          @relation("LeadConvertedCreator", fields: [convertedUserId], references: [id], onDelete: SetNull)
  convertedAt          DateTime?      @map("converted_at")
  notesSummary         String?        @map("notes_summary")
  metadata             Json           @default("{}")
  createdAt            DateTime       @default(now()) @map("created_at")
  updatedAt            DateTime       @updatedAt @map("updated_at")

  platformAccounts LeadPlatformAccount[]
  assignments      LeadAssignment[]
  notes            LeadNote[]
  statusHistory    LeadStatusHistory[]
  creatorProfile   CreatorProfile?
  creatorDocuments CreatorDocument[]
  creatorContracts CreatorContract[]

  @@unique([organizationId, email])
  @@index([organizationId, status, nextFollowUpAt])
  @@index([organizationId, assignedRecruiterId, status])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("creator_leads")
}

model LeadPlatformAccount {
  id             String                    @id @default(cuid())
  organizationId String                    @map("organization_id")
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String                    @map("lead_id")
  lead           CreatorLead               @relation(fields: [leadId], references: [id], onDelete: Cascade)
  platform       PlatformType
  username       String
  profileUrl     String?                   @map("profile_url")
  followers      Int?
  verified       Boolean                   @default(false)
  status         LeadPlatformAccountStatus @default(ACTIVE)
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, platform, username])
  @@index([leadId])
  @@index([organizationId, platform])
  @@map("lead_platform_accounts")
}

model LeadAssignment {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String       @map("lead_id")
  lead           CreatorLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  recruiterId    String       @map("recruiter_id")
  recruiter      User         @relation("LeadAssignmentRecruiter", fields: [recruiterId], references: [id], onDelete: Restrict)
  assignedById   String       @map("assigned_by_id")
  assignedBy     User         @relation("LeadAssignmentAssigner", fields: [assignedById], references: [id], onDelete: Restrict)
  assignedAt     DateTime     @default(now()) @map("assigned_at")
  unassignedAt   DateTime?    @map("unassigned_at")
  reason         String?
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([organizationId, leadId, assignedAt(sort: Desc)])
  @@index([leadId, unassignedAt])
  @@index([recruiterId, unassignedAt])
  @@map("lead_assignments")
}

model LeadNote {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String       @map("lead_id")
  lead           CreatorLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorId       String       @map("author_id")
  author         User         @relation("LeadNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  contactType    ContactType  @map("contact_type")
  note           String
  createdAt      DateTime     @default(now()) @map("created_at")

  @@index([leadId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("lead_notes")
}

model LeadStatusHistory {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadId         String       @map("lead_id")
  lead           CreatorLead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  previousStatus LeadStatus?  @map("previous_status")
  newStatus      LeadStatus   @map("new_status")
  changedById    String       @map("changed_by_id")
  changedBy      User         @relation("LeadStatusChanger", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt      DateTime     @default(now()) @map("changed_at")
  reason         String?

  @@index([leadId, changedAt(sort: Desc)])
  @@index([organizationId, changedAt(sort: Desc)])
  @@map("lead_status_history")
}

model RecruiterProfile {
  id                 String           @id @default(cuid())
  organizationId     String           @map("organization_id")
  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId             String           @map("user_id")
  user               User             @relation("RecruiterProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  displayName        String?          @map("display_name")
  nickname           String?
  territory          String?
  languages          String[]         @default([])
  hireDate           DateTime?        @map("hire_date")
  commissionPlan     CommissionPlan   @default(STANDARD) @map("commission_plan")
  monthlyLeadGoal    Int?             @map("monthly_lead_goal")
  monthlyCreatorGoal Int?             @map("monthly_creator_goal")
  availability       Json             @default("{}")
  managerUserId      String?          @map("manager_user_id")
  manager            User?            @relation("RecruiterProfileManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  status             RecruiterStatus  @default(ACTIVE)
  metadata           Json             @default("{}")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([managerUserId])
  @@index([organizationId, status])
  @@map("recruiter_profiles")
}

model CreatorProfile {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  organization     Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId           String        @map("user_id")
  user             User          @relation("CreatorProfileUser", fields: [userId], references: [id], onDelete: Cascade)
  sourceLeadId     String?       @unique @map("source_lead_id")
  sourceLead       CreatorLead?  @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  displayName      String        @map("display_name")
  bio              String?
  country          String?
  languages        String[]      @default([])
  availability     Json          @default("{}")
  status           CreatorStatus @default(ACTIVE)
  metadata         Json          @default("{}")
  recruiterUserId  String?       @map("recruiter_user_id")
  recruiter        User?         @relation("CreatorProfileRecruiter", fields: [recruiterUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  platformAccounts CreatorPlatformAccount[]
  documents        CreatorDocument[]
  contracts        CreatorContract[]

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([recruiterUserId])
  @@index([organizationId, status])
  @@map("creator_profiles")
}

model CreatorPlatformAccount {
  id               String                    @id @default(cuid())
  organizationId   String                    @map("organization_id")
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorProfileId String                    @map("creator_profile_id")
  creatorProfile   CreatorProfile            @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  platform         PlatformType
  username         String
  profileUrl       String?                   @map("profile_url")
  followers        Int?
  verified         Boolean                   @default(false)
  status           LeadPlatformAccountStatus @default(ACTIVE)
  metadata         Json                      @default("{}")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@unique([organizationId, platform, username])
  @@index([creatorProfileId])
  @@index([organizationId, platform])
  @@map("creator_platform_accounts")
}

/// Onboarding/compliance document metadata. Binary files live in object storage only.
/// At least one of creatorProfileId or sourceLeadId should be set (enforced in application layer).
model CreatorDocument {
  id               String                @id @default(cuid())
  organizationId   String                @map("organization_id")
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorProfileId String?               @map("creator_profile_id")
  creatorProfile   CreatorProfile?       @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  sourceLeadId     String?               @map("source_lead_id")
  sourceLead       CreatorLead?          @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  documentType     CreatorDocumentType   @map("document_type")
  status           CreatorDocumentStatus @default(REQUESTED)
  title            String?
  expiresAt        DateTime?             @map("expires_at")
  reviewedById     String?               @map("reviewed_by_id")
  reviewedBy       User?                 @relation("CreatorDocumentReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?             @map("reviewed_at")
  rejectionReason  String?               @map("rejection_reason")
  metadata         Json                  @default("{}")
  deletedAt        DateTime?             @map("deleted_at")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")

  versions CreatorDocumentVersion[]

  @@index([organizationId])
  @@index([organizationId, creatorProfileId])
  @@index([organizationId, sourceLeadId])
  @@index([organizationId, documentType])
  @@index([organizationId, status])
  @@index([organizationId, creatorProfileId, documentType, status])
  @@index([organizationId, expiresAt])
  @@index([creatorProfileId])
  @@index([sourceLeadId])
  @@map("creator_documents")
}

/// Immutable file reference per document upload. storageKey and checksum are write-once after upload completes.
model CreatorDocumentVersion {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documentId     String          @map("document_id")
  document       CreatorDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  versionNumber  Int             @map("version_number")
  storageKey     String?         @map("storage_key")
  fileName       String?         @map("file_name")
  mimeType       String?         @map("mime_type")
  sizeBytes      Int?            @map("size_bytes")
  checksum       String?
  uploadedById   String          @map("uploaded_by_id")
  uploadedBy     User            @relation("CreatorDocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  uploadedAt     DateTime?       @map("uploaded_at")
  metadata       Json            @default("{}")
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([documentId, versionNumber])
  @@index([organizationId])
  @@index([documentId])
  @@index([uploadedById])
  @@map("creator_document_versions")
}

/// Versioned legal agreement metadata. Signed contract versions are immutable (enforced in application layer).
model CreatorContract {
  id                 String                @id @default(cuid())
  organizationId     String                @map("organization_id")
  organization       Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorProfileId   String?               @map("creator_profile_id")
  creatorProfile     CreatorProfile?       @relation(fields: [creatorProfileId], references: [id], onDelete: Cascade)
  sourceLeadId       String?               @map("source_lead_id")
  sourceLead         CreatorLead?          @relation(fields: [sourceLeadId], references: [id], onDelete: SetNull)
  contractType       CreatorContractType   @map("contract_type")
  status             CreatorContractStatus @default(DRAFT)
  title              String
  parentContractId   String?               @map("parent_contract_id")
  parentContract     CreatorContract?      @relation("ContractAmendments", fields: [parentContractId], references: [id], onDelete: SetNull)
  childContracts     CreatorContract[]     @relation("ContractAmendments")
  validFrom          DateTime?             @map("valid_from")
  validUntil         DateTime?             @map("valid_until")
  signedAt           DateTime?             @map("signed_at")
  signedByUserId     String?               @map("signed_by_user_id")
  signedBy           User?                 @relation("CreatorContractSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  externalEnvelopeId String?               @map("external_envelope_id")
  metadata           Json                  @default("{}")
  deletedAt          DateTime?             @map("deleted_at")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  versions CreatorContractVersion[]

  @@index([organizationId])
  @@index([organizationId, creatorProfileId])
  @@index([organizationId, sourceLeadId])
  @@index([organizationId, contractType])
  @@index([organizationId, status])
  @@index([organizationId, creatorProfileId, contractType, status])
  @@index([organizationId, validUntil])
  @@index([creatorProfileId])
  @@index([sourceLeadId])
  @@index([parentContractId])
  @@map("creator_contracts")
}

/// Contract revision or executed PDF reference. Rows with non-null signedAt must not be updated or deleted (application policy).
model CreatorContractVersion {
  id                 String          @id @default(cuid())
  organizationId     String          @map("organization_id")
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contractId         String          @map("contract_id")
  contract           CreatorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber      Int             @map("version_number")
  storageKey         String?         @map("storage_key")
  fileName           String?         @map("file_name")
  mimeType           String?         @map("mime_type")
  sizeBytes          Int?            @map("size_bytes")
  checksum           String?
  signedAt           DateTime?       @map("signed_at")
  signedByUserId     String?         @map("signed_by_user_id")
  signedBy           User?           @relation("CreatorContractVersionSigner", fields: [signedByUserId], references: [id], onDelete: SetNull)
  externalEnvelopeId String?         @map("external_envelope_id")
  metadata           Json            @default("{}")
  createdAt          DateTime        @default(now()) @map("created_at")

  @@unique([contractId, versionNumber])
  @@index([organizationId])
  @@index([contractId])
  @@index([signedByUserId])
  @@map("creator_contract_versions")
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum CampaignType {
  BRAND_DEAL
  LIVE_STREAM
  TIKTOK_SHOP
  UGC
  AFFILIATE
  OTHER
}

enum CampaignDeliverableStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

model Campaign {
  id                  String         @id @default(cuid())
  organizationId      String         @map("organization_id")
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  description         String?
  brandName           String?        @map("brand_name")
  campaignType        CampaignType   @map("campaign_type")
  status              CampaignStatus @default(DRAFT)
  budgetAmount        Decimal?       @map("budget_amount") @db.Decimal(12, 2)
  budgetCurrency      String?        @map("budget_currency")
  startsAt            DateTime?      @map("starts_at")
  endsAt              DateTime?      @map("ends_at")
  applicationDeadline DateTime?      @map("application_deadline")
  brief               Json           @default("{}")
  requirements        Json           @default("{}")
  metadata            Json           @default("{}")
  createdByUserId     String         @map("created_by_user_id")
  createdBy           User           @relation("CampaignCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  deliverables CampaignDeliverable[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, campaignType])
  @@index([organizationId, startsAt])
  @@index([organizationId, endsAt])
  @@index([createdByUserId])
  @@map("campaigns")
}

model CampaignDeliverable {
  id             String                    @id @default(cuid())
  organizationId String                    @map("organization_id")
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaignId     String                    @map("campaign_id")
  campaign       Campaign                  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  status         CampaignDeliverableStatus @default(DRAFT)
  dueAt          DateTime?                 @map("due_at")
  requirements   Json                      @default("{}")
  metadata       Json                      @default("{}")
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([organizationId, campaignId])
  @@index([organizationId, status])
  @@index([campaignId])
  @@index([campaignId, status])
  @@map("campaign_deliverables")
}
